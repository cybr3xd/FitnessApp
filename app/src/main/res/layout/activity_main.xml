<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:padding="20dp">

    <!-- Колонка иконок: вертикальная линия на 48dp -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/icon_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_begin="48dp" />

    <TextView
        android:id="@+id/StepsCounter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginStart="12dp"
        android:gravity="center_vertical"
        android:text="Steps: 0"
        android:textColor="@color/text_primary"
        android:textSize="28sp"
        android:letterSpacing="0.02"
        app:layout_constraintStart_toEndOf="@id/icon_guideline"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/imageView4"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="12dp"
        android:src="@drawable/fire_107"
        android:contentDescription="@null"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/icon_guideline"
        app:layout_constraintTop_toBottomOf="@+id/imageView3" />

    <ImageView
        android:id="@+id/imageView5"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="20dp"
        android:src="@drawable/timer_6"
        android:contentDescription="@null"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/icon_guideline"
        app:layout_constraintTop_toBottomOf="@+id/imageView4" />

    <Chronometer
        android:id="@+id/timeSpentChronometer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="36dp"
        android:format="Chronometer: %s"
        android:gravity="center_vertical"
        android:textColor="@color/text_secondary"
        android:textSize="18sp"
        app:layout_constraintStart_toEndOf="@id/icon_guideline"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/KilocaloriesBurned" />

    <Button
        android:id="@+id/StartButton"
        android:layout_width="210dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:layout_marginTop="48dp"
        android:background="@drawable/bg_button_primary"
        android:elevation="2dp"
        android:text="Старт"
        android:textAlignment="center"
        android:textColor="@color/text_on_primary"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.497"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/timeSpentChronometer" />

    <Button
        android:id="@+id/PauseButton"
        android:layout_width="160dp"
        android:layout_height="56dp"
        android:layout_marginTop="48dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_button_secondary"
        android:text="Пауза"
        android:textAlignment="center"
        android:textAllCaps="true"
        android:textColor="@color/text_on_primary"
        android:textSize="16sp"
        android:elevation="2dp"
        android:visibility="gone"
        app:layout_constraintEnd_toStartOf="@+id/StopButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/timeSpentChronometer" />

    <Button
        android:id="@+id/StopButton"
        android:layout_width="160dp"
        android:layout_height="56dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="48dp"
        android:background="@drawable/bg_button_primary"
        android:text="Остановка"
        android:textAlignment="center"
        android:textAllCaps="true"
        android:textColor="@color/text_on_primary"
        android:textSize="16sp"
        android:elevation="2dp"
        android:visibility="gone"
        app:layout_constraintStart_toEndOf="@+id/PauseButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/timeSpentChronometer" />

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/button_row_barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="StartButton,StopButton" />

    <TextView
        android:id="@+id/DistanceSpent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:layout_marginStart="12dp"
        android:gravity="center_vertical"
        android:text="Distance: 0 m"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        app:layout_constraintStart_toEndOf="@id/icon_guideline"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/StepsCounter" />

    <TextView
        android:id="@+id/KilocaloriesBurned"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:layout_marginStart="12dp"
        android:gravity="center_vertical"
        android:text="Burned: 0.0 kcal"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        app:layout_constraintStart_toEndOf="@id/icon_guideline"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/DistanceSpent" />

    <ImageView
        android:id="@+id/imageView3"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="16dp"
        android:src="@drawable/measuring_tape_icon"
        android:contentDescription="@null"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/icon_guideline"
        app:layout_constraintTop_toBottomOf="@+id/imageView" />

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="24dp"
        android:src="@drawable/steps_icon"
        android:contentDescription="@null"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/icon_guideline"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/TasksButton"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_gravity="center"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_button_primary"
        android:text="Задачи"
        android:textAlignment="center"
        android:textAllCaps="false"
        android:textColor="@color/text_on_primary"
        android:textSize="17sp"
        android:elevation="2dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/button_row_barrier" />

    <Button
        android:id="@+id/HistoryButton"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_gravity="center"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_button_primary"
        android:text="История"
        android:textAlignment="center"
        android:textAllCaps="false"
        android:textColor="@color/text_on_primary"
        android:textSize="17sp"
        android:elevation="2dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/TasksButton"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_bias="0.9" />

</androidx.constraintlayout.widget.ConstraintLayout>